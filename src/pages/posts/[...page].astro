---
import { getCollection, type CollectionEntry } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import config from "@/config";

// One page at /posts/. Filtering and sorting happen in the browser,
// so every item has to be on the same page.
export function getStaticPaths() {
  return [{ params: { page: undefined } }];
}

type SeriesRow = {
  kind: "series";
  title: string;
  href: string;
  date: number;
  description: string;
  tags: string[];
  parts: number;
};
type PostRow = {
  kind: "post";
  title: string;
  date: number;
  tags: string[];
  post: CollectionEntry<"posts">;
};
type Row = SeriesRow | PostRow;

// Published posts only: no drafts, nothing scheduled for the future.
const now = Date.now();
const posts = await getCollection(
  "posts",
  ({ data }) => !data.draft && new Date(data.pubDatetime).getTime() <= now
);
const allSeries = await getCollection("series", ({ data }) => !data.draft);

// Each series becomes one row, dated by its most recent part.
const seriesRows: SeriesRow[] = [];
for (const series of allSeries) {
  const parts = posts.filter(p => p.data.series === series.id);
  if (parts.length === 0) continue;
  seriesRows.push({
    kind: "series",
    title: series.data.title,
    href: `/series/${series.id}/`,
    date: Math.max(...parts.map(p => new Date(p.data.pubDatetime).getTime())),
    description: series.data.description,
    tags: [...new Set(parts.flatMap(p => p.data.tags ?? []))],
    parts: parts.length,
  });
}

// Every published post gets a row, including posts that belong to a series.
const postRows: PostRow[] = posts.map((post): PostRow => ({
  kind: "post",
  title: post.data.title,
  date: new Date(post.data.pubDatetime).getTime(),
  tags: post.data.tags ?? [],
  post,
}));

// Each row renders as its own <ul>, so the theme's Card component (an <li>) is reused as-is.
const items: Row[] = [...seriesRows, ...postRows].sort((a, b) => b.date - a.date);

// Tag options are built from whatever tags the content uses.
const tags = [...new Set(items.flatMap(i => i.tags))].sort();

const formatDate = (ms: number) =>
  new Date(ms).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: config.site.timezone,
  });
---

<Layout title={`Posts | ${config.site.title}`} description="All the articles I've posted.">
  <Header />
  <Breadcrumb />
  <Main pageTitle="Posts" pageDesc="All the articles I've posted.">
    <div id="posts-index">
      <div class="flex flex-wrap gap-2" role="group" aria-label="Show">
        <button type="button" class="pill" data-type="all" aria-pressed="true">All</button>
        <button type="button" class="pill" data-type="post" aria-pressed="false">Posts</button>
        <button type="button" class="pill" data-type="series" aria-pressed="false">Series</button>
      </div>

      <div class="mt-4 flex flex-wrap items-center gap-2 text-sm">
        {
          tags.length > 0 && (
            <button type="button" class="pill toggle" data-panel="tag-panel" aria-expanded="false" aria-controls="tag-panel">
              Tag: <span id="tag-label">All</span> <span aria-hidden="true">▾</span>
            </button>
          )
        }
        <button type="button" class="pill toggle" data-panel="sort-panel" aria-expanded="false" aria-controls="sort-panel">
          Sort: <span id="sort-label">Newest first</span> <span aria-hidden="true">▾</span>
        </button>
        <span id="posts-count" class="text-muted-foreground ms-2"></span>
      </div>

      {
        tags.length > 0 && (
          <div id="tag-panel" class="panel mt-3 flex flex-wrap gap-2" role="group" aria-label="Filter by tag" hidden>
            <button type="button" class="pill" data-tag="" aria-pressed="true">All</button>
            {tags.map(t => (
              <button type="button" class="pill" data-tag={t} aria-pressed="false">{t}</button>
            ))}
          </div>
        )
      }

      <div id="sort-panel" class="panel mt-3 flex flex-wrap gap-2" role="group" aria-label="Sort" hidden>
        <button type="button" class="pill" data-sort="newest" aria-pressed="true">Newest first</button>
        <button type="button" class="pill" data-sort="oldest" aria-pressed="false">Oldest first</button>
        <button type="button" class="pill" data-sort="title" aria-pressed="false">Title A–Z</button>
      </div>

      <div id="posts-list" class="mt-4">
        {
          items.map(item =>
            item.kind === "post" ? (
              <ul
                data-type="post"
                data-tags={item.tags.join("|")}
                data-date={item.date}
                data-title={item.title.toLowerCase()}
              >
                <Card {...item.post} />
              </ul>
            ) : (
              <ul
                data-type="series"
                data-tags={item.tags.join("|")}
                data-date={item.date}
                data-title={item.title.toLowerCase()}
              >
                <li class="my-6">
                  <a
                    href={item.href}
                    class="text-accent inline-block text-lg font-medium decoration-dashed underline-offset-4 hover:underline focus-visible:no-underline"
                  >
                    {item.title}
                  </a>
                  <p class="text-muted-foreground my-1 text-sm">
                    <span class="badge">Series</span> {item.parts} parts · Updated{" "}
                    {formatDate(item.date)}
                  </p>
                  <p>{item.description}</p>
                </li>
              </ul>
            )
          )
        }
      </div>

      <p id="posts-empty" class="text-muted-foreground" hidden>
        Nothing matches these filters.
      </p>
    </div>
  </Main>
  <Footer />
</Layout>

<style>
  .pill {
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 0.3rem 1rem;
    font-size: 0.9rem;
  }
  .pill[aria-pressed="true"],
  .pill[aria-expanded="true"] {
    border-color: var(--accent);
    background: var(--muted);
  }
  .panel[hidden] {
    display: none;
  }
  .badge {
    border: 1px solid var(--accent);
    color: var(--accent);
    border-radius: 0.25rem;
    padding: 0 0.35rem;
    font-size: 0.75rem;
  }
</style>

<script>
  // AstroPaper uses view transitions, so set up on every page load.
  function initPostsIndex() {
    const root = document.getElementById("posts-index");
    const list = document.getElementById("posts-list");
    if (!root || !list) return;

    const rows = Array.from(list.children) as HTMLElement[]; // one <ul> per row
    const typeButtons = Array.from(root.querySelectorAll<HTMLElement>("button[data-type]"));
    const tagButtons = Array.from(root.querySelectorAll<HTMLElement>("button[data-tag]"));
    const sortButtons = Array.from(root.querySelectorAll<HTMLElement>("button[data-sort]"));
    const toggles = Array.from(root.querySelectorAll<HTMLElement>("button[data-panel]"));
    const tagLabel = root.querySelector<HTMLElement>("#tag-label");
    const sortLabel = root.querySelector<HTMLElement>("#sort-label");
    const count = root.querySelector<HTMLElement>("#posts-count");
    const empty = root.querySelector<HTMLElement>("#posts-empty");

    let type = "all";
    let tag = "";
    let sort = "newest";

    const press = (buttons: HTMLElement[], isActive: (b: HTMLElement) => boolean) =>
      buttons.forEach(b => b.setAttribute("aria-pressed", String(isActive(b))));

    const apply = () => {
      const sorted = [...rows].sort((a, b) => {
        if (sort === "title") return (a.dataset.title ?? "").localeCompare(b.dataset.title ?? "");
        const diff = Number(a.dataset.date) - Number(b.dataset.date);
        return sort === "oldest" ? diff : -diff;
      });

      let visible = 0;
      for (const row of sorted) {
        const match =
          (type === "all" || row.dataset.type === type) &&
          (!tag || (row.dataset.tags ?? "").split("|").includes(tag));
        row.hidden = !match;
        if (match) visible++;
        list.appendChild(row); // re-appending in sorted order moves the element
      }

      press(typeButtons, b => b.dataset.type === type);
      press(tagButtons, b => (b.dataset.tag ?? "") === tag);
      press(sortButtons, b => b.dataset.sort === sort);
      if (tagLabel) tagLabel.textContent = tag || "All";
      if (sortLabel) {
        sortLabel.textContent =
          sortButtons.find(b => b.dataset.sort === sort)?.textContent ?? "Newest first";
      }
      if (count) count.textContent = `${visible} of ${rows.length}`;
      if (empty) empty.hidden = visible > 0;
    };

    // Opening one panel closes the other.
    toggles.forEach(toggle => {
      toggle.onclick = () => {
        const opening = toggle.getAttribute("aria-expanded") !== "true";
        toggles.forEach(t => {
          const panel = document.getElementById(t.dataset.panel ?? "");
          const open = opening && t === toggle;
          t.setAttribute("aria-expanded", String(open));
          if (panel) panel.hidden = !open;
        });
      };
    });

    typeButtons.forEach(b => (b.onclick = () => { type = b.dataset.type ?? "all"; apply(); }));
    tagButtons.forEach(b => (b.onclick = () => { tag = b.dataset.tag ?? ""; apply(); }));
    sortButtons.forEach(b => (b.onclick = () => { sort = b.dataset.sort ?? "newest"; apply(); }));

    apply();
  }

  document.addEventListener("astro:page-load", initPostsIndex);
</script>
